# Cascade path of the metadata set to use for events.
# The event metadata fields are created dynamically from the metadata set.
EVENTS_METADATA_SET = '/'

# Cascade ID of the data definition to use for events.
# The event fields are created dynamically from the data definition.
EVENTS_DATA_DEF_ID = ''   # '/'

# Cascade path of the structured data definition to use for on-campus location options.
EVENTS_ON_CAMPUS_LOCATIONS = '/'

# Cascade path of the base asset to clone for creating event assets in Cascade.
EVENTS_PAGE_BASE_ASSET = '/'

# Cascade path of the base asset file to clone for creating image assets in Cascade.
EVENTS_IMAGE_BASE_ASSET = '/'

# Cascade path of the folder to upload event images to.
EVENTS_IMAGE_FOLDER = '/'

# Cascade workflow ID to assign to event assets in Cascade.
EVENTS_WORKFLOW_ID = '' # '/'

# URL of the XML feed of events data to pull for the events listing page.
EVENTS_XML_URL = 'https://'

# Cascade XML ID of the event feed to allow publishing the feed after an event is deleted.
EVENT_XML_ID = '' # '/'

# Cascade path of the folder to clone for adding new year folders for events.
BASE_ASSET_EVENT_FOLDER = '/'

# Used in the testing_suite only
WTF_CSRF_ENABLED = False/True